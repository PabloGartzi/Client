<%- include('../user/userMenu') %>

<main>
    <form action="/search/pelicula" id="buscadorPelis" class="buscadorPelis">
        <input type="text" id="titulo" name="titulo" class="titulo" placeholder="Buscar película" autofocus required>
        <button type="submit" id="botonBuscar" class="btn botonBuscar">Buscar 🔍</button>
    </form>

    <p class="tituloWeb">Resultado de la búsqueda</p>

    <div class="flexContainer containerResultado">
        <% if (respuesta && respuesta.ok && respuesta.data && respuesta.data.length > 0) { %>
            <% respuesta.data.forEach(peli => { %>
                <article class="tarjetaPelicula">
                    <div class="img">
                        <img src="<%= peli.imagen_url %>" alt="<%= peli.titulo %>">
                    </div>
                    <div class="infoPelicula">
                        <h2><%= peli.titulo %></h2>
                        <p><%= peli.director %></p>
                    </div>
                    <div class="favorito">
                        <form action="/user/anadirFavoritos" method="POST">
                            <input type="hidden" name="id_peliculas" value="<%= peli.id_peliculas %>">
                            <button class="btn-corazon"><%= peli.esFavorito ? '❤️' : '♡' %></button>
                        </form>
                    </div>
                </article>
            <% }) %>
        <% } else { %>
            <p class="mensajeError"><%= respuesta?.msg || 'No se encontraron películas con ese título.' %></p>
        <% } %>
    </div>
</main>

<%- include('../templates/footer') %>
