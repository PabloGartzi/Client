<%- include('../templates/header') %>

    <%- include('../user/userMenu') %>

        <main>

            <p class="tituloWeb">Mis películas favoritas</p>

            <!--Aquí van las tarjetas con las pelis guardadas-->
            <div class="flexContainer containerVariaspelis">
                <!-- capturar todas las pelis favoritas y hacer un for each para pintarlas -->

                <% if(respuesta.ok && respuesta.data.length> 0) { %>

                    <% respuesta.data.forEach(({ id_peliculas, imagen_url, titulo, director })=> { %>
                        <!--revisar el id_peliculas, qué nombre se le ha dado en las funciones controladoras -->

                        <a href="/user/detalleFavorito/<%= id_peliculas %>" class="enlacePeliFavorita">
                            <!--cada tarjetita es un link que me lleva al detalle de esa peli-->
                            <article class="tarjetaPelicula">
                                <div class="img">
                                    <img src="<%= imagen_url %>" alt="<%= titulo %>">
                                </div>
                                <div class="infoPelicula">
                                    <h2>
                                        <%= titulo %>
                                    </h2>
                                    <p>
                                        <%= director %>
                                    </p>
                                </div>
                            </article>
                        </a>
                        <form action="/user/deleteFavorito" method="POST">
                            <input type="hidden" name="id_peliculas" value="<%= id_peliculas %>">
                            <button class="btn-corazon"><%= '♡' %></button>
                        </form>

                        <% }) %>

                            <% } else { %>
                                <p class="mensajeError">
                                    <% if (respuesta.data && respuesta.data.length == 0) { %>
                                        Aún no tienes películas favoritas.
                                    <% } else { %>
                                        <%= respuesta.msg %>
                                    <% } %>
                                </p>
                                <% } %>
            </div>
        </main>

        <%- include('../templates/footer') %>