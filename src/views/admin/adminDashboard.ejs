<%- include('../templates/header') %>

    <main class="adminDashboard">

        <p class="tituloWeb">Mis Películas - Admin Dashboard </p>

        <button class="btn botonCrearPeli">
            <a href="/createMovie" class="enlaceCrearPeli">Crear una peli</a>
        </button>

        <!-- Aquí se muestra la lista de películas creadas -->

        <div class="flexContainer containerVariaspelis">

            <% if(respuesta.ok && respuesta.data.length> 0) { %>

                <% respuesta.data.forEach(({ id_peliculas, imagen_url, titulo, director })=> { %>
                    <article class="tarjetaPelicula">
                        <div class="img">
                            <img src="<%= imagen_url %>" alt="<%= titulo %>">
                        </div>
                        <div class="infoPelicula">
                            <h2>
                                <%= titulo %>
                            </h2>
                            <p>
                                <%= director %>
                            </p>
                        </div>

                        <div class="accionesPelicula">
                            <!-- Botón editar -->
                            <a href="/admin/editMovie<%= id_peliculas %>" class="btn-editar">Editar</a>

                            <!-- Botón eliminar -->
                            <form action="/admin/removeMovie" method="POST">
                                <input type="hidden" name="id_pelicula" value="<%= id_peliculas %>">
                                <button type="submit" class="btn-borrar">Borrar</button>
                            </form>
                        </div>

                    </article>

                    <% }) %>

                        <% } else { %>
                            <p class="mensajeError">
                                <%= respuesta.msg %>
                            </p>s

                            <% } %>
        </div>

    </main>


    <%- include('../templates/footer') %>