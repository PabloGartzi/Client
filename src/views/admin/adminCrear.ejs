<%- include('../templates/header') %>
<%- include('./adminMenu') %>

<main class="containerCrear">
    
    <p class="tituloWeb">Crear una película</p>
    
    <% if (error) { %>
        <p style="color: red; padding: 10px; border: 1px solid red; margin-bottom: 15px;"><%= error %></p>
    <% } %>

    <form action="/admin/createMovie" method="POST" class="formularioCrear" enctype="multipart/form-data"> 
        
        <label for="titulo">Título</label>
        <input type="text" id="titulo" name="titulo" required>

        <label for="director">Director (ID o Nombre)</label>
        <input type="text" id="director" name="director" required>

        <label for="anio">Año</label>
        <input type="number" id="anio" name="anio" required>

        <label for="duracion_en_min">Duración (minutos)</label>
        <input type="number" id="duracion_en_min" name="duracion_en_min" required>

        <label for="genero">Género (ID o Nombre)</label>
        <input type="text" id="genero" name="genero" required>

        <label for="imagen">Imagen de la Película:</label>
        <input type="file" id="imagen" name="imagen" accept="image/*" required>

        <label for="sinopsis">Sinopsis</label>
        <textarea id="sinopsis" name="sinopsis" rows="6" required></textarea>
        
        <button type="submit" class="btn">Guardar Película</button>
        
    </form>
</main>

<%- include('../templates/footer') %>