<%- include('../templates/header') %>

<main class="containerCrear">
    
    <p class="tituloWeb">Crear una película</p>
    
    <form action="/createMovie" method="POST" enctype="multipart/form-data" class="formularioCrear" id="formularioCrear">
        
        <label for="titulo">Título</label>
        <input type="text" id="titulo" name="titulo" required>

        <label for="director">Director</label>
        <input type="text" id="director" name="director" required>

        <label for="anio">Año</label>
        <input type="text" id="anio" name="anio" required>

        <label for="duracion_en_min">Duración</label>
        <input type="text" id="duracion_en_min" name="duracion_en_min" required>

        <label for="genero">Género</label>
        <input type="text" id="genero" name="genero" required>

        <label for="imagen">Imagen de la Película:</label>
        <input type="file" id="imagen" name="imagen" required>

         <label for="sinopsis">Sinopsis</label>
        <textarea id="sinopsis" name="sinopsis" rows="6" required></textarea>
        
        <button type="submit" class="btn">Guardar Película</button>
        
    </form>
</main>

<%- include('../templates/footer') %>